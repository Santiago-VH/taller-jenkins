<?xml version="1.0" encoding="UTF-8"?>
<!--
    settings.xml usado por el pipeline (mvn deploy -s ci-settings.xml).
    NO contiene secretos: Maven lee las variables de entorno NEXUS_USER y
    NEXUS_PASS, que Jenkins inyecta con withCredentials (credencial
    "nexus-credentials") y enmascara en los logs.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
    <servers>
        <server>
            <id>nexus-releases</id>
            <username>${env.NEXUS_USER}</username>
            <password>${env.NEXUS_PASS}</password>
        </server>
    </servers>
</settings>
