<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.icesi</groupId>
    <artifactId>studytrack-api</artifactId>
    <!--
        Versionado inmutable (CI-friendly): la versión real la inyecta el
        pipeline con -Drevision=1.0.<BUILD_NUMBER>-<commit corto>, de modo que
        cada build publica un artefacto único y trazable a su commit.
        El valor por defecto solo se usa en builds locales.
    -->
    <version>${revision}</version>
    <name>studytrack-api</name>
    <description>Backend REST de StudyTrack (Taller Evaluativo 2 - Ingeniería de Software V)</description>

    <properties>
        <java.version>17</java.version>
        <revision>1.0.0-local</revision>
        <!-- URL base de Nexus. Desde el host: localhost:9081.
             Desde el contenedor de Jenkins (red cicd_network): http://nexus:8081 -->
        <nexus.url>http://localhost:9081</nexus.url>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>studytrack-api</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- Reemplaza ${revision} por la versión concreta en el pom que se
                 publica en Nexus (requerido al usar versiones CI-friendly). -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.6.0</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten-clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!--
        ============================================================
        Fase 2 - Publicación Inmutable en Nexus
        El <id> debe coincidir con el <server> de settings.xml (ci-settings.xml),
        donde Jenkins inyecta usuario/clave desde la credencial nexus-credentials.
        maven-releases tiene política "Release" + "Disable redeploy": una
        versión publicada nunca se sobrescribe.
        ============================================================
    -->
    <distributionManagement>
        <repository>
            <id>nexus-releases</id>
            <name>Nexus maven-releases</name>
            <url>${nexus.url}/repository/maven-releases/</url>
        </repository>
    </distributionManagement>

</project>
