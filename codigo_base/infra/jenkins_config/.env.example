# Copie este archivo como ".env" dentro de infra/jenkins_config/ y
# complete los valores.

# Puerto del host -> 8080 (UI de Jenkins)
JENKINS_UI_PORT=9082
# Puerto del host -> 50000 (conexión de agentes inbound)
JENKINS_AGENT_PORT=50000
# Canal creado en https://smee.io (el mismo que se registra como webhook en GitHub)
SMEE_CHANNEL_URL=https://smee.io/REEMPLACE-CON-SU-CANAL
